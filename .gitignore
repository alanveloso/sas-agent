.venv/
__pycache__/
*.pyc
sas_mvp.db
.coverage
*.db-journal
mapeamento_paths.log
# Legacy sandbox at repo root only; benchmarks/metrics_sandbox/ is versioned.
/metrics_sandbox/

# Benchmarks: version scripts, profiles and generated data, but not the
# local venv, per-run logs or transient temp DBs.
benchmarks/.venv/
benchmarks/logs/
benchmarks/**/*.db
benchmarks/**/*.db-journal
benchmarks/**/*.db-wal
benchmarks/**/*.db-shm

# Secrets / local junk
*.key
certs/private/
scratch/
tmp/
*.pid
.pytest_cache/
dist/
build/

# Artifacts: keep structure + manifests/tables; ignore huge local dumps if any
artifacts/**/*.db
artifacts/**/*.log
artifacts/raw/**/scratch/

# Campanhas locais (gerar de novo; não versionar raw/smoke)
artifacts/raw/*
!artifacts/raw/tnsm-factorial/
!artifacts/raw/tnsm-factorial/**
artifacts/tables/
artifacts/figures/
artifacts/manifests/
artifacts/processed/
!artifacts/README.md

# Dados/logs locais de bench (saída antiga)
benchmarks/data/*
!benchmarks/data/README.md
